    "]\n",
    "\n",
    "# First file has header\n",
    "df = pd.read_csv(files[0], engine='python', on_bad_lines='skip')\n",
    "\n",
    "# Rest DO NOT have header — use the same column names as the first file\n",
    "for f in files[1:]:\n",
    "    temp = pd.read_csv(f, header=None, names=df.columns, engine='python', on_bad_lines='skip')\n",
    "    df = pd.concat([df, temp], ignore_index=True)\n",
    "\n",
    "# If first row is actually the real header\n",
    "if df.columns[0] != \"REF_DATE\": \n",
    "    df.columns = df.iloc[0]\n",
    "    df = df[1:]\n",
    "\n",
    "print(\"Combined employment dataset:\", df.shape)\n",
    "# Convert REF_DATE to datetime\n",
    "df['REF_DATE'] = pd.to_datetime(df['REF_DATE'], errors='coerce')\n",
    "\n",
    "# remove missing for all analyses\n",
    "df = df.dropna(subset=['REF_DATE'])\n",
    "df = df[df['REF_DATE'].notnull()]\n",
    "\n",
    "# remove missing  age groups data\n",
    "df = df[df['Age group'].notnull()]\n",
    "\n",
    "# remove missing education degree\n",
    "df = df[df['Educational degree'].notnull()]\n",
    "\n",
    "\n",
    "EE_Wage_Trend = df.copy()"
   ]
